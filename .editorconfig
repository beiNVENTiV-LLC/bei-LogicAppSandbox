# beiNVENTiV bei-LogicAppSandbox editor conventions
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false

[*.bicep]
indent_size = 2

[*.bicepparam]
indent_size = 2

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab

[VERSION]
insert_final_newline = true
